pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
#include script.p8
#include lowercase.p8

char_x = 0
char_y = 0

function _draw()
	cls()
	char_y = 0

	for i=1,#script do
		for j=1,#script[i] do
			cprint(script[i][j],0,char_y)
			char_y += 8
		end
	end
end
